%%{init: {"theme": "base", "themeVariables": {"background": "#ffffff", "primaryColor": "#f7f7f7", "primaryTextColor": "#1b2a3a", "primaryBorderColor": "#b0b0b0", "lineColor": "#5a6472", "textColor": "#1b2a3a", "edgeLabelBackground": "#ffffff", "clusterBkg": "#fafafa", "clusterBorder": "#b0b0b0", "fontFamily": "Segoe UI, Helvetica, Arial, sans-serif"}}}%%
flowchart LR
  classDef app fill:#cfe8ff,stroke:#6a9fd1,color:#1b2a3a
  classDef core fill:#d8f3dc,stroke:#74b98a,color:#1b2a3a
  classDef data fill:#fff3bf,stroke:#d4b84a,color:#1b2a3a
  classDef ext fill:#ffd8d8,stroke:#d08a8a,color:#1b2a3a
  classDef cv fill:#e6d9f7,stroke:#9b82c9,color:#1b2a3a
  classDef task fill:#ffffff,stroke:#8a8a8a,color:#1b2a3a
  classDef box fill:#f7f7f7,stroke:#b0b0b0,color:#333333

  subgraph PHONE["Phone (streaming app)"]
    CAM["Phone camera<br/>fixed resolution, no stabilisation"]:::ext
  end

    subgraph MB["make_board.exe"]
      MBMAIN["make_board main"]:::app
    end
    subgraph CAL["calibrate.exe"]
      CALMAIN["calibrate main<br/>keys s / c / w (WIP)"]:::app
      T1["Task 1: detect + draw corners"]:::task
      T2["Task 2: select frames (s)"]:::task
      T3["Task 3: calibrateCamera (c), write (w)"]:::task
      CALMAIN --> T1 --> T2 --> T3
    end
    subgraph AR["ar.exe"]
      ARMAIN["ar main (WIP)"]:::app
      T4["Task 4: pose R, t per frame"]:::task
      T5["Task 5: axes + projected corners"]:::task
      T6["Task 6: virtual line object"]:::task
      OBJ["objects.h<br/>vector of Segment3D"]:::app
      ARMAIN --> T4 --> T5 --> T6
      OBJ -- "Segment3D list" --> T6
    end
    subgraph FEAT["features.exe"]
      FMAIN["features main (WIP)"]:::app
      T7["Task 7: Harris + ORB features"]:::task
      FMAIN --> T7
    end

  subgraph CORE["calibar_core (static lib, linked into calibrate / ar / features)"]
    direction LR
    VS["video_source"]:::core
    CH["charuco<br/>detectCharuco, objectPointsFor"]:::core
    IO["intrinsics_io<br/>save / load"]:::core
    PS["pose<br/>estimatePose"]:::core
    DR["draw<br/>drawAxes, drawSegments"]:::core
    AA["app_args"]:::core
    CH --> PS
    PS --> DR
  end

  subgraph OCV["OpenCV 5.0"]
    direction LR
    OVIDEO["videoio"]:::cv
    OOBJ["objdetect: CharucoDetector"]:::cv
    OCAL["calib: calibrateCamera, solvePnP, projectPoints"]:::cv
    OFS["core: FileStorage"]:::cv
    OFEAT["imgproc + features2d: cornerHarris, ORB"]:::cv
  end

  subgraph FS["Filesystem"]
    direction LR
    BOARD[("data/board/*.png")]:::data
    VID[("data/samples/board.mp4")]:::data
    FIX[("data/calib/fixture.yml")]:::data
    YML[("data/calib/*.yml")]:::data
    IMGS[("data/calib/images/")]:::data
  end

  CAM -- "frames over Wi-Fi URL" --> VS
  VID -- "headless frames" --> VS
  MBMAIN -- "board image" --> BOARD
  BOARD -. "shown on tablet / printed, filmed by phone" .-> CAM

  VS -- "frames" --> CALMAIN
  VS -- "frames" --> ARMAIN
  VS -- "frames" --> FMAIN
  CH -- "corners + ids" --> T1
  T2 -- "calibration frames" --> IMGS
  T3 -- "Intrinsics" --> IO
  IO -- "intrinsics YAML" --> YML
  YML -- "intrinsics YAML" --> IO
  FIX -. "approx. intrinsics until real calibration" .-> IO
  IO -- "Intrinsics" --> T4
  PS -- "Pose (rvec, tvec)" --> T4
  DR -- "projected overlay" --> T5

  VS --> OVIDEO
  CH --> OOBJ
  IO --> OFS
  PS --> OCAL
  DR --> OCAL
  T3 -- "calibrateCamera" --> OCAL
  T7 -- "features" --> OFEAT

  class CORE,OCV,FS,PHONE,MB,CAL,AR,FEAT box
