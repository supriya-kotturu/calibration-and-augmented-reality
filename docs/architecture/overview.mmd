%%{init: {"theme": "base", "flowchart": {"nodeSpacing": 45, "rankSpacing": 65, "padding": 16, "curve": "basis"}, "themeVariables": {"fontSize": "18px", "background": "#ffffff", "primaryColor": "#f7f7f7", "primaryTextColor": "#1b2a3a", "primaryBorderColor": "#b0b0b0", "lineColor": "#5a6472", "textColor": "#1b2a3a", "edgeLabelBackground": "#ffffff", "clusterBkg": "#fafafa", "clusterBorder": "#b0b0b0", "fontFamily": "Segoe UI, Helvetica, Arial, sans-serif"}}}%%
flowchart TB
  classDef app fill:#cfe8ff,stroke:#6a9fd1,stroke-width:2px,color:#1b2a3a
  classDef task fill:#eef6ff,stroke:#6a9fd1,stroke-width:1.5px,color:#1b2a3a
  classDef core fill:#d8f3dc,stroke:#74b98a,stroke-width:2px,color:#1b2a3a
  classDef data fill:#fff3bf,stroke:#d4b84a,stroke-width:2px,color:#1b2a3a
  classDef ext fill:#ffd8d8,stroke:#d08a8a,stroke-width:2px,color:#1b2a3a
  classDef cv fill:#e6d9f7,stroke:#9b82c9,stroke-width:2px,color:#1b2a3a
  classDef box fill:#fbfbfb,stroke:#9aa3ad,stroke-width:1.5px,stroke-dasharray:6 4,color:#1b2a3a
  classDef exe fill:#f4f9ff,stroke:#6a9fd1,stroke-width:1.5px,color:#1b2a3a

  subgraph WORLD["Physical setup"]
    direction LR
    TAB("Tablet<br/>shows the ChArUco board"):::ext
    PHONE("Phone + IP Webcam<br/>960×544 MJPEG stream"):::ext
    TAB -- "filmed by" --> PHONE
  end

  subgraph APPS["Executables (one per job)"]
    direction LR
    subgraph CAL["calibrate.exe"]
      direction TB
      T1("Task 1<br/>detect + draw corners"):::task
      T2("Task 2<br/>save views (s)"):::task
      T3("Task 3<br/>calibrateCamera (c), write (w)"):::task
      T1 --> T2 --> T3
    end
    subgraph AR["ar.exe"]
      direction TB
      T4("Task 4<br/>pose rvec, tvec"):::task
      T5("Task 5<br/>axes + board outline"):::task
      T6("Task 6<br/>house / cube (objects.h)"):::task
      T4 --> T5 --> T6
    end
    subgraph FEAT["features.exe"]
      direction TB
      T7("Task 7<br/>Harris, ORB, SIFT, matching"):::task
    end
    MB("make_board.exe"):::app
  end

  subgraph CORE["calibar_core (static library)"]
    direction LR
    VS("video_source<br/>index / file / URL"):::core
    CH("charuco<br/>detect + id → 3D point"):::core
    PS("pose<br/>solvePnP"):::core
    DR("draw<br/>projectPoints"):::core
    IO("intrinsics_io<br/>YAML + resolution"):::core
  end

  subgraph FILES["Files"]
    direction LR
    BOARD[("board PNG")]:::data
    YML[("phone.yml<br/>intrinsics")]:::data
    SAMPLE[("board.mp4<br/>sample recording")]:::data
  end

  OCV{{"OpenCV 5.0<br/>objdetect · calib · geometry · features"}}:::cv

  PHONE -- "frames over Wi-Fi" --> VS
  SAMPLE -- "frames (headless)" --> VS
  MB -- "renders" --> BOARD
  BOARD -. "displayed on" .-> TAB

  VS -- "frames" --> CAL
  VS -- "frames" --> AR
  VS -- "frames" --> FEAT
  CH -- "corners + ids" --> CAL
  CH -- "corners + ids" --> PS
  CAL -- "writes" --> IO
  IO <-- "save / load" --> YML
  IO -- "intrinsics" --> PS
  PS -- "pose" --> AR
  DR -- "overlay" --> AR

  CORE -- "uses" --> OCV
  FEAT -- "uses" --> OCV

  class WORLD,APPS,CORE,FILES box
  class CAL,AR,FEAT exe
